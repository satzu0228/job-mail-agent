JOB_MAIL_APP_NAME=Job Mail Agent API
JOB_MAIL_ENVIRONMENT=development
JOB_MAIL_DEBUG=false
JOB_MAIL_API_V1_PREFIX=/api/v1
JOB_MAIL_DEMO_USER_ID=1

# MySQL 8 business database. Replace credentials locally; never commit real secrets.
JOB_MAIL_DATABASE_URL=mysql+pymysql://job_mail:change-me@127.0.0.1:3306/job_mail_agent?charset=utf8mb4
JOB_MAIL_DB_POOL_RECYCLE=1800

# LangGraph SQLite checkpoint file. Runtime database files are ignored by Git.
JOB_MAIL_CHECKPOINT_PATH=runtime/checkpoints.sqlite
# 16/24/32-byte AES key encoded as 32/48/64 hexadecimal characters.
# Generate locally and never commit the real value.
JOB_MAIL_CHECKPOINT_ENCRYPTION_KEY=replace-with-a-random-aes-key

# Email authorization codes are encrypted at rest with a separate AES key.
# Generate locally as 16/24/32 random bytes encoded in hexadecimal.
JOB_MAIL_EMAIL_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-random-aes-key

# Email access. Users enter provider authorization codes in the settings page.
JOB_MAIL_EMAIL_CONNECT_TIMEOUT_SECONDS=15
JOB_MAIL_EMAIL_SYNC_LIMIT=50
JOB_MAIL_EMAIL_MAX_MESSAGE_BYTES=10485760
# 轻量轮询仅负责触发已有幂等同步和工作流，不替代 MySQL/checkpoint。
JOB_MAIL_AUTOMATION_ENABLED=true
JOB_MAIL_AUTOMATION_POLL_SECONDS=30
JOB_MAIL_REMINDER_LEAD_MINUTES=60

# LLM provider. API Key、模型、温度等参数请在「设置 > AI 模型」页面配置。
JOB_MAIL_LLM_PROVIDER=deepseek
