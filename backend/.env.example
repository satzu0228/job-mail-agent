JOB_MAIL_APP_NAME=Job Mail Agent API
JOB_MAIL_ENVIRONMENT=development
JOB_MAIL_DEBUG=false
JOB_MAIL_API_V1_PREFIX=/api/v1

# MySQL 8 business database. Replace credentials locally; never commit real secrets.
JOB_MAIL_DATABASE_URL=mysql+pymysql://job_mail:change-me@127.0.0.1:3306/job_mail_agent?charset=utf8mb4
JOB_MAIL_DB_POOL_RECYCLE=1800

# LangGraph SQLite checkpoint file. Runtime database files are ignored by Git.
JOB_MAIL_CHECKPOINT_PATH=runtime/checkpoints.sqlite

# LLM configuration. DeepSeek is the MVP implementation; never commit a real key.
JOB_MAIL_LLM_PROVIDER=deepseek
JOB_MAIL_LLM_MODEL=deepseek-chat
JOB_MAIL_LLM_API_KEY=replace-with-your-deepseek-api-key
JOB_MAIL_LLM_TEMPERATURE=0
JOB_MAIL_LLM_TIMEOUT_SECONDS=60
JOB_MAIL_LLM_MAX_RETRIES=2
