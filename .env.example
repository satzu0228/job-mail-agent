# LLM provider: deepseek or qwen
LLM_PROVIDER=deepseek
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Compatibility variable used by Email-AI-Agent
DEEPSEEK_API_KEY=

# IMAP test account
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_SERVER=
IMAP_PORT=993

# SMTP test account
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SERVER=
EMAIL_PORT=587

# Optional observability; keep disabled unless explicitly configured
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=job-mail-agent-phase-1

